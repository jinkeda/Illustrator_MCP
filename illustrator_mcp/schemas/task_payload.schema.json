    "TargetSelector": {
      "description": "\n    Complete target selector with ordering.\n    \n    The 'target' field can be a simple selector or compound.\n    The 'orderBy' field ensures deterministic result ordering.\n    ",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Complete target selector with ordering.\n\nThe 'target' field can be a simple selector or compound.\nThe 'orderBy' field ensures deterministic result ordering.",
          "properties": {
            "target": {
              "discriminator": {
                "mapping": {
                  "all": "#/$defs/AllTarget",
                  "compound": "#/$defs/CompoundTarget",
                  "grid": "#/$defs/GridTarget",
                  "handle": "#/$defs/HandleTarget",
                  "id": "#/$defs/IdTarget",
                  "layer": "#/$defs/LayerTarget",
                  "query": "#/$defs/QueryTarget",
                  "selection": "#/$defs/SelectionTarget",
                  "spatial": "#/$defs/SpatialTarget"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/SelectionTarget"
                },
                {
                  "$ref": "#/$defs/LayerTarget"
                },
                {
                  "$ref": "#/$defs/AllTarget"
                },
                {
                  "$ref": "#/$defs/QueryTarget"
                },
                {
                  "$ref": "#/$defs/IdTarget"
                },
                {
                  "$ref": "#/$defs/HandleTarget"
                },
                {
                  "$ref": "#/$defs/SpatialTarget"
                },
                {
                  "$ref": "#/$defs/GridTarget"
                },
                {
                  "$ref": "#/$defs/CompoundTarget"
                }
              ],
              "title": "Target"
            },
            "orderBy": {
              "$ref": "#/$defs/OrderBy",
              "default": "zOrder",
              "description": "Result ordering (critical for layout reproducibility)"
            },
            "exclude": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ExcludeFilter"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Global exclusion filter (applied after target resolution)"
            },
            "maxScan": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Optional selector scan cap. If the cap prevents a complete result, resolution fails explicitly instead of returning a partial/no-match result.",
              "title": "Maxscan"
            },
            "expect": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TargetExpectation"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "target"
          ],
          "title": "TargetSelector",
          "type": "object"
        },
