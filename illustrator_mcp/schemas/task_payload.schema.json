    "RetryPolicy": {
      "additionalProperties": false,
      "description": "Stage-specific retry configuration.",
      "properties": {
        "maxAttempts": {
          "default": 3,
          "description": "Max retry attempts",
          "maximum": 5,
          "minimum": 1,
          "title": "Maxattempts",
          "type": "integer"
